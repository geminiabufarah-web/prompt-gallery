# ==============================================================================
# Prompt Gallery — Environment Variables
# ==============================================================================

# Supabase (Required for cloud sync & authentication)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Cloudflare R2 (Optional for direct uploads from client/backend)
# NOTE: In client-side only environments, ensure R2 CORS is enabled or use a backend worker.
VITE_R2_ACCOUNT_ID=your-cloudflare-account-id
VITE_R2_ACCESS_KEY_ID=your-r2-access-key-id
VITE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
VITE_R2_BUCKET_NAME=prompt-gallery-images
VITE_R2_PUBLIC_URL=https://images.yourdomain.com
